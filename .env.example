NODE_ENV=production
PORT=3000
DATABASE_URL=file:/data/finance.db
JWT_SECRET=CHANGE_ME_LONG_RANDOM_32PLUS_CHARS
ALLOW_REGISTER=false
TRUST_PROXY=1
BACKUP_DIR=/data/backups
DOCKER_NETWORK=proxy
# APP_ORIGIN=https://finance.example.com
# CORS_ORIGIN=https://finance.example.com

# Optional in-process Yahoo allowlist gap-fill (or use host cron: npm run market:sync-yahoo-gaps)
# MARKET_YAHOO_GAP_SYNC=true
# MARKET_YAHOO_GAP_SYNC_UTC_HOUR=21

# Local npm run dev (not Docker): copy backend/.env.example instead
# DATABASE_URL=file:./dev.db
# PORT=4000
# ALLOW_REGISTER=true
