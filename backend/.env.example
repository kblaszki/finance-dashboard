DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-random-string-at-least-32-characters-long"
PORT=4000

# Production: set to false after creating your user (see README — Private deployment)
# NODE_ENV=production requires JWT_SECRET (32+ chars, not a published placeholder).
# ALLOW_REGISTER=false is recommended for private deploy (create users via create-user).
ALLOW_REGISTER=true

# Optional production hardening (see docs/how-to/private-deploy.md)
# CORS_ORIGIN=https://finance.example.com
# APP_ORIGIN=https://finance.example.com
# JSON_BODY_LIMIT=1mb
# TRUST_PROXY=1

# Twelve Data (Markets catalog + non-GPW quotes) — npm run build && npm run market:sync-catalog|market:sync-quotes
# TWELVE_DATA_API_KEY=
# TWELVE_DATA_API_BASE=https://api.twelvedata.com

# Oanor GPW quotes (Poland / GPW / WSE favorites) — header x-oanor-key
# OANOR_API_KEY=
# OANOR_GPW_API_BASE=https://api.oanor.com/gpw-api


# Optional backup script (npm run db:backup) — requires npm run build
# BACKUP_DIR=backups
# BACKUP_GZIP=true

# Optional NBP FX sync (npm run fx:sync) — default https://api.nbp.pl/api
# NBP_API_BASE=https://api.nbp.pl/api
