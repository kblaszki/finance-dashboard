DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-random-string-at-least-32-characters-long"
PORT=4000

# Production: set to false after creating your user (see README — Private deployment)
# NODE_ENV=production also requires JWT_SECRET (32+ chars) and ALLOW_REGISTER=false
ALLOW_REGISTER=true

# Optional production hardening (see docs/how-to/private-deploy.md)
# CORS_ORIGIN=https://your-domain.example
# JSON_BODY_LIMIT=1mb
# TRUST_PROXY=1

# Future / unused unless market sync is shipped
# MARKET_DATA_API_KEY=
# SEED_MARKET_BACKFILL_DAYS=500

# Optional backup script (npm run db:backup) — requires npm run build
# BACKUP_DIR=backups
# BACKUP_GZIP=true
