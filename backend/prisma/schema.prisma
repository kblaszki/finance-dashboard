generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  username     String     @unique
  /// Lowercase username used for case-insensitive login and uniqueness.
  usernameKey  String     @unique
  passwordHash String
  /// Incremented on password change so older JWTs fail requireAuth.
  tokenVersion Int        @default(0)
  createdAt    DateTime   @default(now())
  accounts     Account[]
  categories   Category[]
  tags         Tag[]
  cashTransfers CashTransfer[]
}

model Category {
  id        Int       @id @default(autoincrement())
  userId    Int
  name      String
  /// Sibling key: `{parentId or 0}:{lowercase name}`.
  nameKey   String
  /// INCOME | EXPENSE | TRANSFER; inherited from parent; fixed for the subtree.
  ledgerType String
  parentId  Int?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  cashTransactions CashTransaction[]
  cashTransfers CashTransfer[]

  @@unique([userId, nameKey])
  @@index([userId])
  @@index([parentId])
  @@index([userId, ledgerType])
}

model Account {
  id              Int               @id @default(autoincrement())
  userId          Int
  accountType     String
  name            String
  currency        String
  /// Minor units (cents). JSON APIs expose major units.
  cashBalance     Int               @default(0)
  openingBalance  Int               @default(0)
  openingCashAsOf DateTime?
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashTransactions CashTransaction[]
  transfersFrom   CashTransfer[]    @relation("TransferFrom")
  transfersTo     CashTransfer[]    @relation("TransferTo")

  @@unique([userId, name])
  @@index([userId, accountType])
}

model CashTransfer {
  id            Int       @id @default(autoincrement())
  userId        Int
  fromAccountId Int
  toAccountId   Int
  /// Minor units (cents) on the source account. Always positive.
  amountFrom    Int
  /// Minor units (cents) on the destination account. Always positive.
  amountTo      Int
  occurredAt    DateTime  @default(now())
  description   String?
  /// Optional TRANSFER-group category; copied onto both ledger legs.
  categoryId    Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount   Account   @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account   @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  legs          CashTransaction[]

  @@index([userId, occurredAt])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([categoryId])
}

model CashTransaction {
  id          Int       @id @default(autoincrement())
  accountId   Int
  type        String
  /// Minor units (cents). Always positive. JSON APIs expose major units.
  amount      Int
  occurredAt  DateTime  @default(now())
  description String?
  categoryId  Int?
  transferId  Int?
  createdAt   DateTime  @default(now())
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transfer    CashTransfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)
  cashTransactionTags CashTransactionTag[]

  @@index([accountId, occurredAt])
  @@index([categoryId])
  @@index([transferId])
}

/// User-scoped free-form label for cash ledger rows (not categories).
model Tag {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  /// Lowercase trimmed name for uniqueness per user.
  nameKey   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashTransactionTags CashTransactionTag[]

  @@unique([userId, nameKey])
  @@index([userId])
}

model CashTransactionTag {
  cashTransactionId Int
  tagId             Int
  cashTransaction   CashTransaction @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)
  tag               Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cashTransactionId, tagId])
  @@index([tagId])
}
