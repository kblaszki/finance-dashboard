generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  username     String     @unique
  /// Lowercase username used for case-insensitive login and uniqueness.
  usernameKey  String     @unique
  passwordHash String
  /// Incremented on password change so older JWTs fail requireAuth.
  tokenVersion Int        @default(0)
  createdAt    DateTime   @default(now())
  accounts     Account[]
  categories   Category[]
}

model Category {
  id        Int       @id @default(autoincrement())
  userId    Int
  name      String
  parentId  Int?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  cashTransactions CashTransaction[]

  @@index([userId])
  @@index([parentId])
}

model Account {
  id              Int               @id @default(autoincrement())
  userId          Int
  accountType     String
  name            String
  currency        String
  /// Minor units (cents). JSON APIs expose major units.
  cashBalance     Int               @default(0)
  openingBalance  Int               @default(0)
  openingCashAsOf DateTime?
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashTransactions CashTransaction[]

  @@unique([userId, name])
  @@index([userId, accountType])
}

model CashTransaction {
  id          Int       @id @default(autoincrement())
  accountId   Int
  type        String
  /// Minor units (cents). Always positive. JSON APIs expose major units.
  amount      Int
  occurredAt  DateTime  @default(now())
  description String?
  categoryId  Int?
  createdAt   DateTime  @default(now())
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([accountId, occurredAt])
  @@index([categoryId])
}
