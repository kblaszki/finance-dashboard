generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  username     String     @unique
  /// Lowercase username used for case-insensitive login and uniqueness.
  usernameKey  String     @unique
  passwordHash String
  /// Incremented on password change so older JWTs fail requireAuth.
  tokenVersion Int        @default(0)
  createdAt    DateTime   @default(now())
  accounts     Account[]
  categories   Category[]
  tags         Tag[]
  cashTransfers CashTransfer[]
  csvImportPresets CsvImportPreset[]
  importBatches ImportBatch[]
  categoryDescriptionRules CategoryDescriptionRule[]
  watchlistItems WatchlistItem[]
}

model Category {
  id        Int       @id @default(autoincrement())
  userId    Int
  name      String
  /// Sibling key: `{parentId or 0}:{lowercase name}`.
  nameKey   String
  /// INCOME | EXPENSE | TRANSFER; inherited from parent; fixed for the subtree.
  ledgerType String
  parentId  Int?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  cashTransactions CashTransaction[]
  cashTransfers CashTransfer[]
  descriptionRules CategoryDescriptionRule[]

  @@unique([userId, nameKey])
  @@index([userId])
  @@index([parentId])
  @@index([userId, ledgerType])
}

/// User rule: if normalized description contains pattern → category (import suggest).
model CategoryDescriptionRule {
  id         Int      @id @default(autoincrement())
  userId     Int
  /// Normalized substring matched with contains.
  pattern    String
  patternKey String
  /// INCOME | EXPENSE
  ledgerType String
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, ledgerType, patternKey])
  @@index([userId, ledgerType])
  @@index([categoryId])
}

model Account {
  id              Int               @id @default(autoincrement())
  userId          Int
  accountType     String
  name            String
  currency        String
  /// Minor units (cents). JSON APIs expose major units.
  cashBalance     Int               @default(0)
  openingBalance  Int               @default(0)
  openingCashAsOf DateTime?
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashTransactions CashTransaction[]
  transfersFrom   CashTransfer[]    @relation("TransferFrom")
  transfersTo     CashTransfer[]    @relation("TransferTo")
  csvImportPresets CsvImportPreset[]
  importBatches ImportBatch[]

  @@unique([userId, name])
  @@index([userId, accountType])
}

/// Audit record for a cash ledger CSV import commit (deduped uploads).
model ImportBatch {
  id                    Int      @id @default(autoincrement())
  userId                Int
  accountId             Int
  /// ledger_csv | columns_csv
  source                String
  createdCount          Int
  skippedDuplicateCount Int
  skippedTransferCount  Int
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
}

/// Saved CSV column mapping for flexible account imports (header names, not indices).
model CsvImportPreset {
  id          Int      @id @default(autoincrement())
  userId      Int
  accountId   Int
  name        String
  /// Lowercase trimmed name for uniqueness per account.
  nameKey     String
  /// JSON: { occurredAt, amount, description?, type?, categoryPath?, amountSignMode? } — header names.
  mappingJson String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, nameKey])
  @@index([userId])
  @@index([accountId])
}

model CashTransfer {
  id            Int       @id @default(autoincrement())
  userId        Int
  fromAccountId Int
  toAccountId   Int
  /// Minor units (cents) on the source account. Always positive.
  amountFrom    Int
  /// Minor units (cents) on the destination account. Always positive.
  amountTo      Int
  occurredAt    DateTime  @default(now())
  description   String?
  /// Optional TRANSFER-group category; copied onto both ledger legs.
  categoryId    Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount   Account   @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account   @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  legs          CashTransaction[]

  @@index([userId, occurredAt])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([categoryId])
}

model CashTransaction {
  id          Int       @id @default(autoincrement())
  accountId   Int
  type        String
  /// Minor units (cents). Always positive. JSON APIs expose major units.
  amount      Int
  occurredAt  DateTime  @default(now())
  description String?
  categoryId  Int?
  transferId  Int?
  createdAt   DateTime  @default(now())
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transfer    CashTransfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)
  cashTransactionTags CashTransactionTag[]

  @@index([accountId, occurredAt])
  @@index([categoryId])
  @@index([transferId])
}

/// User-scoped free-form label for cash ledger rows (not categories).
model Tag {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  /// Lowercase trimmed name for uniqueness per user.
  nameKey   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashTransactionTags CashTransactionTag[]

  @@unique([userId, nameKey])
  @@index([userId])
}

model CashTransactionTag {
  cashTransactionId Int
  tagId             Int
  cashTransaction   CashTransaction @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)
  tag               Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cashTransactionId, tagId])
  @@index([tagId])
}

/// Global NBP mid rate for one foreign currency on one calendar day (never PLN).
model FxRateDaily {
  id       Int      @id @default(autoincrement())
  /// UTC midnight of the NBP effective date.
  rateDate DateTime
  /// EUR | USD (extend whitelist later).
  currency String
  /// NBP mid: major PLN per 1 foreign unit.
  mid      Decimal
  createdAt DateTime @default(now())

  @@unique([rateDate, currency])
  @@index([currency, rateDate])
}

/// Shared market catalog row (Twelve Data stocks/ETFs). No userId.
model Instrument {
  id             Int       @id @default(autoincrement())
  /// Display / search ticker (e.g. AAPL).
  symbol         String
  name           String
  exchange       String    @default("")
  micCode        String?
  country        String?
  /// Quote currency from provider (e.g. USD).
  currency       String    @default("USD")
  /// STOCK | ETF
  assetClass     String
  /// twelve_data
  provider       String    @default("twelve_data")
  /// Symbol string passed to Twelve Data APIs (may include exchange suffix).
  providerSymbol String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  valuations     InstrumentValuation[]
  watchlistItems WatchlistItem[]

  @@unique([provider, providerSymbol])
  @@index([symbol])
  @@index([assetClass])
  @@index([name])
}

/// EOD (or similar) close for one instrument on one UTC calendar day.
model InstrumentValuation {
  id           Int        @id @default(autoincrement())
  instrumentId Int
  /// UTC midnight of the valuation date.
  asOfDate     DateTime
  /// Major units in instrument.currency.
  close        Decimal
  /// twelve_data | manual
  source       String     @default("twelve_data")
  createdAt    DateTime   @default(now())
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, asOfDate, source])
  @@index([instrumentId, asOfDate])
}

/// User favorite instrument for the Markets watchlist.
model WatchlistItem {
  id           Int        @id @default(autoincrement())
  userId       Int
  instrumentId Int
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
  @@index([userId])
  @@index([instrumentId])
}
