# Copy to backend/.env before: docker compose up -d --build
# Do not commit the real .env file.

DATABASE_URL=file:/app/data/prod.db
JWT_SECRET=replace-with-random-32-plus-chars
PORT=4000
ALLOW_REGISTER=false

# Set by docker-compose.yml as well; safe to leave here for clarity
# NODE_ENV=production
# BACKUP_DIR=/app/data/backups
# TRUST_PROXY=1

# Same-origin behind reverse proxy: leave CORS_ORIGIN unset.
# Only set when the UI and API are on different origins.
# CORS_ORIGIN=https://finance.example.com

# JSON_BODY_LIMIT=1mb

# Future / unused unless market sync is shipped — not required for go-live
# MARKET_DATA_API_KEY=
# MARKET_BACKFILL_DAYS=90
